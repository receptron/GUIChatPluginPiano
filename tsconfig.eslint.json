{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    "declarationDir": null,
    "jsx": "react-jsx"
  },
  "include": [
    "*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "demo/**/*.ts",
    "demo/**/*.tsx",
    "demo/**/*.vue",
    "demo-react/**/*.ts",
    "demo-react/**/*.tsx",
    "demo-react/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
